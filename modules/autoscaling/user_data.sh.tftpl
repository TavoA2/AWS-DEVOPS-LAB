#!/bin/bash

set -e

dnf install -y docker

systemctl enable docker
systemctl start docker

aws ecr get-login-password --region ${aws_region} | \
docker login \
  --username AWS \
  --password-stdin ${ecr_registry}

docker pull ${container_image}

docker run -d \
  --name aws-devops-web \
  --restart always \
  -p 80:80 \
  --log-driver=awslogs \
  --log-opt awslogs-region=${aws_region} \
  --log-opt awslogs-group=/aws/ec2/${environment}/nginx/access \
  --log-opt awslogs-stream=container-$(hostname) \
  ${container_image}